{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "rootDir": "src",
    "outDir": "../dist.next/shell",
    "rewriteRelativeImportExtensions": true,
    "types": ["bun-types"],
    "paths": {
      "cogmem": ["../dist.next/public.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
