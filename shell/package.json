{
  "name": "@cogmem/companion-shell",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "Cog's resident companion shell: state machine, plugin host and terminal interface. Built into the cogmem package as dist/shell; not installed separately.",
  "bin": {
    "cog": "src/cog.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts start",
    "once": "bun run src/cli.ts once",
    "probe": "bun run src/cli.ts probe",
    "test": "bun test test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "bun-types": "1.3.11"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15",
    "turndown": "^7.2.5"
  }
}
