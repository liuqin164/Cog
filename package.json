{
  "name": "cogmem",
  "version": "5.0.0",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "description": "Cog — a resident companion agent with a governed long-term memory kernel that runs on your own machine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuqin164/Cog.git"
  },
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "import": "./dist/public.js",
      "types": "./dist/public.d.ts"
    },
    "./internal": {
      "import": "./dist/internal.js",
      "types": "./dist/internal.d.ts"
    }
  },
  "bin": {
    "cog": "dist/bin/cog.js",
    "cogmem": "dist/bin/cogmem.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs",
    "prepare": "node -e \"const fs=require('node:fs');if(fs.existsSync('scripts/build.mjs'))require('node:child_process').execFileSync(process.execPath,['scripts/build.mjs'],{stdio:'inherit'})\"",
    "prepublishOnly": "bun run typecheck && bun run build && bun test __tests__ && bun run leak:check && npm pack --dry-run --json",
    "type": "tsc -p tsconfig.json --noEmit",
    "test": "bun test __tests__",
    "ci:status": "bun scripts/ci-status.ts",
    "leak:check": "bun scripts/leak-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scorecard": "bun scripts/scorecard.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.0.227",
    "turndown": "^7.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "protobufjs": "^7.6.6",
    "@xmldom/xmldom": "0.8.15"
  },
  "optionalDependencies": {
    "hnswlib-node": "^2.0.1"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "bun-types": "^1.0.0",
    "typescript": "^5.4.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/observatory/web/**",
    "install.sh",
    "README.md",
    "MEMORY_MODEL.md",
    "RECALL_EXPLAINABILITY.md",
    "MEMORY_ATLAS.md",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "CONCURRENT_ACCESS.md",
    "CONTRIBUTING.md",
    "RELEASE_CHECKLIST.md",
    "docs/agent-install.md",
    "docs/install.md",
    "docs/observatory.md",
    "docs/events.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
